# Editor settings that agree with `.gitattributes`, so an editor writes a file
# the way git stores it instead of the two correcting each other on every save.
# `.gitattributes` is what holds the line ending; this file is what keeps an
# editor from putting the other one back.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml,cfg}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown. Trimming them changes
# what the document says, so this is off here and on everywhere else.
trim_trailing_whitespace = false
